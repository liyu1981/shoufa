# ---------------------------------------------------------------------------
# Storage backend selection
# ---------------------------------------------------------------------------
# The app picks the first configured backend in this order:
#   1. Self-hosted Shoufa Redis (lower cost, full control)
#   2. Upstash / cloud Redis (fallback)
#   3. In-process memory (development only, not shared between instances)
#
# Only one pair needs to be set in production. If both are set, self-hosted wins.

# --- Option 1: self-hosted Shoufa Redis (server/) -------------------------
# Start it with: pnpm redis:selfhost
# The API key is generated at ~/.config/shoufad/config for a manual run,
# or at /etc/shoufad/config when installed with `shoufad service-install`.
# SHOUFA_REDIS_REST_URL=http://127.0.0.1:8079
# SHOUFA_REDIS_REST_TOKEN=sfr_your-generated-key

# Shorter aliases are also accepted:
# SHOUFA_REDIS_URL=http://127.0.0.1:8079
# SHOUFA_REDIS_TOKEN=sfr_your-generated-key

# --- Option 2: Upstash / cloud Redis --------------------------------------
# Get these from https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Tier configuration (optional)
# Options: free (default), pro, enterprise
# UPSTASH_TIER=free

# Custom limits override (optional, JSON format)
# UPSTASH_LIMITS='{"commandsPerSecond":10000,"maxTtl":3600,"maxImageSize":5242880}'
